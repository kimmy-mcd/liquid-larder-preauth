{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/staff/",
      "has": [{ "type": "host", "value": "pay.liquidandlarder.com.au" }],
      "destination": "https://hub.liquidandlarder.com.au/",
      "permanent": false
    },
    {
      "source": "/staff/:path+/",
      "has": [{ "type": "host", "value": "pay.liquidandlarder.com.au" }],
      "destination": "https://hub.liquidandlarder.com.au/:path+/",
      "permanent": false
    },
    {
      "source": "/staff/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/staff/:rest+/",
      "destination": "/:rest+/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "pay.liquidandlarder.com.au" }],
      "destination": "/guest/",
      "permanent": false
    }
  ]
}
